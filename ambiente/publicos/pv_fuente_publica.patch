+"use client";
+import Link from "next/link";
+import { useMemo, useState, type ChangeEvent } from "react";
+import {
+  BUDGET_COP, CATALOG, DEFAULT_PORTFOLIOS, CASE_SNAPSHOT, compareCatalogue, evaluatePortfolio,
+  exportPortfoliosJson, importPortfoliosJson, exportPortfoliosCsv, importPortfoliosCsv,
+  scopeCondition,
+  type Portfolio,
+} from "../hackathon/p2_motor_carteras";
+import { Table, money, number } from "./common";
+import "../hackathon/p2_motor_demo.css";
+
+const municipalities: Record<string, string> = { "05615": "Rionegro", "05318": "Guarne", "05440": "Marinilla" };
+
+function download(text: string, format: "json" | "csv") {
+  const url = URL.createObjectURL(new Blob([text], { type: format === "json" ? "application/json;charset=utf-8" : "text/csv;charset=utf-8" }));
+  const anchor = document.createElement("a");
+  anchor.href = url;
+  anchor.download = `p2_motor_carteras.${format}`;
+  anchor.click();
+  setTimeout(() => URL.revokeObjectURL(url), 1000);
+}
+
+export function P2MotorDemo() {
+  const [portfolios, setPortfolios] = useState<Portfolio[]>(DEFAULT_PORTFOLIOS);
+  const [message, setMessage] = useState("");
+  const [error, setError] = useState("");
+  const comparison = useMemo(() => compareCatalogue(), []);
+  const catalog = useMemo(() => new Map(CATALOG.map(entry => [entry.id, entry])), []);
+  const evaluated = portfolios.map(portfolio => ({ portfolio, result: evaluatePortfolio(portfolio) }));
+  const hasPrincipal = portfolios.some(p => p.id === "M6-2");
+  const hasAny14 = portfolios.some(p => p.units.some(u => u.catalogue_id === "RETO-14"));
+  const hasLegacy14 = portfolios.some(p => p.units.some(u => u.catalogue_id === "RETO-14" && u.scope_hypothesis !== "municipal_rionegro_proposed"));
+
+  async function importFile(event: ChangeEvent<HTMLInputElement>) {
+    const file = event.target.files?.[0];
+    event.target.value = "";
+    if (!file) return;
+    setMessage("");
+    setError("");
+    try {
+      if (file.size > 1_000_000) throw new Error("El archivo supera el límite de 1 MB.");
+      const text = await file.text();
+      const imported = file.name.toLowerCase().endsWith(".csv") ? importPortfoliosCsv(text)
+        : file.name.toLowerCase().endsWith(".json") ? importPortfoliosJson(text)
+        : (() => { throw new Error("Use un archivo JSON o CSV de carteras exportado desde esta vista."); })();
+      imported.forEach(evaluatePortfolio);
+      setPortfolios(imported);
+      const legacy = imported.some(p => p.units.some(u => u.catalogue_id === "RETO-14" && u.scope_hypothesis !== "municipal_rionegro_proposed"));
+      setMessage(legacy ? "Casos importados. RETO-14 conserva la hipótesis anterior, sin alcance aprobado; no se reasignó a Rionegro ni se añadió plazo."
+        : "Casos importados y costos recalculados con el catálogo oficial.");
+    } catch (cause) {
+      setError(cause instanceof Error ? cause.message : "No se pudo validar el archivo.");
+    }
+  }
+
+  return (
+    <main className="page-content p2-motor-demo" id="contenido">
+      <header className="page-title">
+        <div>
+          <Link href="/">◈ Presupuesto Vivo · Consulta pública</Link>
+          <p className="eyebrow">CORNARE · RIONEGRO / GUARNE / MARINILLA</p>
+          <h1>{hasPrincipal ? "Tres carteras, un presupuesto" : "Legado D6 y N1, un presupuesto"}</h1>
+          <p className="muted small">Consulta y exportación financiera abiertas, sin cuenta. La administración de proyectos requiere iniciar sesión.</p>
+          <p>{!hasAny14
+            ? "Comparación de carteras importadas sin RETO-14; no se atribuye alcance municipal ni plazo a una medida ausente."
+            : hasLegacy14
+            ? "Comparación de hipótesis importadas: RETO-14 conserva su alcance anterior no aprobado, sin reasignación municipal ni plazo añadido."
+            : hasPrincipal ? "M6-2 principal PROVISIONAL; D6 comparador histórico y N1 comparador. RETO-14: una unidad municipal propuesta para Rionegro, 12 meses desde el acta de inicio. Comparación financiera con costos completos del reto."
+            : "Legado D6/N1 importado, sin añadir M6-2. RETO-14 conserva su unidad municipal propuesta para Rionegro, 12 meses desde el acta de inicio."}</p>
+        </div>
+      </header>
+
+      <div className="notice warning">
+        <strong>Cupos y elegibilidad territorial: condicionales.</strong> El cálculo supone como máximo una unidad indivisible por fila. Los sitios, actores y cobertura requieren validación; estas cifras no certifican beneficio ambiental ni robustez climática.
+      </div>
+
+      <section className="card" aria-labelledby="p2-summary">
+        <h2 id="p2-summary">Comparación conjunta</h2>
+        <p>Fondo único: <strong>{money(BUDGET_COP)}</strong>. Cada cartera se evalúa por separado. Una unidad compartida entre municipios conserva un costo y un conteo.</p>
+        <Table headings={["Cartera", "Unidades", "Costo (millones COP)", "Saldo (millones COP)", "Presupuesto", "Elegibilidad"]}>
+          {evaluated.map(({ portfolio, result }) => (
+            <tr key={portfolio.id} data-testid={`summary-${portfolio.id}`}>
+              <td><strong>{portfolio.name}</strong></td>
+              <td>{result.count}</td>
+              <td>{number(result.cost_cop / 1_000_000)}</td>
+              <td>{number(result.balance_cop / 1_000_000)}</td>
+              <td>{result.financially_feasible ? "Dentro del fondo" : "Excede el fondo"}</td>
+              <td>Condicional</td>
+            </tr>
+          ))}
+        </Table>
+        <div className="p2-motor-actions">
+          <button onClick={() => download(exportPortfoliosJson(portfolios), "json")}>Exportar carteras JSON</button>
+          <button className="secondary" onClick={() => download(exportPortfoliosCsv(portfolios), "csv")}>Exportar carteras CSV</button>
+          <button className="secondary" onClick={() => { setPortfolios(DEFAULT_PORTFOLIOS); setError(""); setMessage("M6-2 principal, D6 histórico y N1 restaurados."); }}>Restaurar M6-2, D6 y N1</button>
+        </div>
+        <label className="p2-motor-import">Importar tres casos o legado D6/N1 JSON o CSV
+          <input type="file" accept=".json,.csv,application/json,text/csv" onChange={importFile} />
+        </label>
+        <p className="muted small">La importación abre una comparación local. Exporte el archivo para conservarla; al recargar se vuelve a M6-2, D6 histórico y N1.</p>
+        {message && <p className="notice success" role="status">{message}</p>}
+        {error && <p className="notice error" role="alert">{error}</p>}
+      </section>
+
+      <div className="p2-motor-portfolios">
+        {evaluated.map(({ portfolio, result }) => (
+          <section className="card" key={portfolio.id} aria-labelledby={`heading-${portfolio.id}`}>
+            <h2 id={`heading-${portfolio.id}`}>{portfolio.name}</h2>
+            <p><strong>{result.count} unidades · {money(result.cost_cop)}</strong><br />Saldo: {money(result.balance_cop)} · Elegibilidad condicional.</p>
+            <Table headings={["Medida oficial", "Unidad completa", "Costo (millones COP)", "Municipios"]}>
+              {portfolio.units.map(unit => {
+                const entry = catalog.get(unit.catalogue_id)!;
+                return <tr key={unit.id}>
+                  <td><strong>{entry.id}</strong><p>{entry.measure}</p><small>{entry.dimension}</small></td>
+                  <td>{entry.functional_unit}<p className="muted">Cantidad: 1 · Cupo condicional</p>
+                    {entry.id === "RETO-01" && unit.duration_months === 36 && <p>UNA unidad territorial · 36 meses completos · municipios propuestos indicados; sin predios ni contrato aprobados.</p>}
+                    {entry.id === "RETO-15" && <p>Localización PROPUESTA · factor de gestión por concretar; código MEA no verificado.</p>}
+                    {entry.id === "RETO-14" && <p><strong>{scopeCondition(unit)}.</strong></p>}
+                  </td>
+                  <td>{number(entry.cost_cop / 1_000_000)}</td>
+                  <td>{unit.municipalities.length ? unit.municipalities.map(code => municipalities[code]).join(", ") : "Asignación pendiente"}{portfolio.id === "M6-2" && unit.catalogue_id === "RETO-01" && <p>Prioridad territorial propuesta; no predios asignados.</p>}</td>
+                </tr>;
+              })}
+            </Table>
+          </section>
+        ))}
+      </div>
+
+      <section className="card" aria-labelledby="p2-enumeration">
+        <h2 id="p2-enumeration">Límite financiero condicionado</h2>
+        <p data-testid="financial-enumeration">{number(comparison.subsets_examined)} subconjuntos examinados; <strong>{number(comparison.feasible_count)} factibles, incluida la cartera vacía</strong>. Máximo financiero: <strong>{comparison.max_count} unidades</strong>; <strong>{comparison.maximum_candidates.length} carteras</strong> alcanzan ese máximo.</p>
+        <details>
+          <summary>Ver las siete carteras financieras de seis unidades</summary>
+          <Table headings={["Unidades del catálogo", "Costo (millones COP)", "Saldo (millones COP)"]}>
+            {comparison.maximum_candidates.map(candidate => <tr key={candidate.ids.join("-")}><td>{candidate.ids.join(" / ")}</td><td>{number(candidate.cost_cop / 1_000_000)}</td><td>{number(candidate.balance_cop / 1_000_000)}</td></tr>)}
+          </Table>
+        </details>
+        <p className="muted small">El máximo depende de la hipótesis de una unidad por fila; no establece un máximo ambiental. No hay ranking por eficacia ni un ganador automático. M6-2 es la principal PROVISIONAL por decisión documental; D6 es histórico y N1 comparador.</p>
+      </section>
+
+      <footer className="card">
+        <strong>Fuente y límites</strong>
+        <p>{CASE_SNAPSHOT.source_commit ? `Fuente publicada: commit ${CASE_SNAPSHOT.source_commit}` : "Fuente: staging congelado por SHA; commit real de publicación pendiente."} · {CASE_SNAPSHOT.version}</p>
+        <p>RETO CLIMATE WEEK HACKATHON.pdf, páginas 4–5; 15 filas con precio. IDs RETO locales, sin equivalencia automática a códigos MEA. PSA: programa íntegro de tres años, COP 1.200 millones. Restauración: unidad integral de aproximadamente 100 ha, COP 1.500 millones.</p>
+        <p className="muted small">Las condiciones territoriales, la elegibilidad y el contraste ambiental acompañan la decisión documental del equipo. La comparación conserva sus faltantes.</p>
+        <Link href="/login">Administrar proyectos (requiere iniciar sesión)</Link>
+      </footer>
+    </main>
+  );
+}

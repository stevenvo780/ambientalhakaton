+import Papa from "papaparse";
+import catalogue from "./p2_motor_catalogo.json";
+import snapshot from "./pv_m62_snapshot.json";
+export const CASE_SNAPSHOT = snapshot;
+
+/** Comparación presupuestal del caso oficial; independiente del optimizador productivo. */
+export const CATALOG = Object.freeze(catalogue.map((row) => Object.freeze({ ...row })));
+export const BUDGET_COP = 5_000_000_000;
+export const SOURCE_SHA256 = "4bfa305f9ba4f0553ad9a2e51fa24a18ab544f14a8e602348522e46c5067f1f6";
+export const COUNTING_ASSUMPTION = "Máximo una unidad indivisible por fila del catálogo";
+export const ELIGIBILITY = "CONDICIONAL: cupos y elegibilidad territorial pendientes de validación";
+export const RETO14_REGIONAL_CONDITION = "RETO-14: una unidad regional PROPUESTA por validar; no acredita un SAT completo RETO-13";
+export const RETO14_SCOPE_CONDITION = "RETO-14: una unidad municipal PROPUESTA completa en Rionegro (05615); 12 meses desde el acta de inicio, sin fecha aprobada; no acredita un SAT completo RETO-13";
+export type Scope14 = "municipal_rionegro_proposed" | "regional_proposed" | "legacy_unspecified";
+export function scopeCondition(unit: Unit): string {
+  if (unit.catalogue_id !== "RETO-14") return "";
+  if (unit.scope_hypothesis === "municipal_rionegro_proposed") return RETO14_SCOPE_CONDITION;
+  if (unit.scope_hypothesis === "regional_proposed") return `${RETO14_REGIONAL_CONDITION}; hipótesis importada, sin alcance ni plazo aprobados`;
+  return "RETO-14: hipótesis anterior de alcance y plazo no especificados ni aprobados; sin reasignación municipal; no acredita un SAT completo RETO-13";
+}
+const unitEligibility = (unit: Unit) => unit.catalogue_id === "RETO-14"
+  ? `${ELIGIBILITY}. ${scopeCondition(unit)}` : ELIGIBILITY;
+const FORMAT = "p2_motor_demo_v2";
+const MUNICIPALITIES = new Set(["05615", "05318", "05440"]);
+const byId = new Map(CATALOG.map((row) => [row.id, row]));
+
+export type Unit = {
+  id: string;
+  functional_unit_id: string;
+  catalogue_id: string;
+  quantity: number;
+  municipalities: string[];
+  scope_hypothesis?: Scope14;
+  duration_months?: 12 | 36 | null;
+  start_basis?: "acta_inicio" | null;
+};
+export type Portfolio = { id: string; name: string; units: Unit[] };
+
+function defaultPortfolio(id: string, name: string, ids: number[]): Portfolio {
+  return { id, name, units: ids.map((n) => {
+    const catalogue_id = `RETO-${String(n).padStart(2, "0")}`;
+    return { id: `${id}-${catalogue_id}`, functional_unit_id: `${catalogue_id}-UF-01`, catalogue_id, quantity: 1,
+      municipalities: n === 14 ? ["05615"] : [],
+      ...(n === 14 ? { scope_hypothesis: "municipal_rionegro_proposed" as const, duration_months: 12 as const, start_basis: "acta_inicio" as const } : {}),
+    };
+  }) };
+}
+
+export const LEGACY_PORTFOLIOS: Portfolio[] = [
+  defaultPortfolio("D6", "BASE PROVISIONAL D6", [3, 4, 7, 8, 9, 14]),
+  defaultPortfolio("N1", "N1", [1, 3, 4, 5, 14]),
+];
+
+export const DEFAULT_PORTFOLIOS: Portfolio[] = [
+  defaultPortfolio("M6-2", "M6-2 · PRINCIPAL PROVISIONAL", [1, 3, 4, 8, 14, 15]),
+  { ...LEGACY_PORTFOLIOS[0], name: "D6 · COMPARADOR HISTÓRICO" },
+  { ...LEGACY_PORTFOLIOS[1], name: "N1 · COMPARADOR" },
+];
+for (const unit of DEFAULT_PORTFOLIOS[0].units) {
+  if (["RETO-01", "RETO-03", "RETO-04"].includes(unit.catalogue_id)) unit.municipalities = ["05615", "05440"];
+  if (unit.catalogue_id === "RETO-08") unit.municipalities = ["05318"];
+  if (unit.catalogue_id === "RETO-15") unit.municipalities = ["05440"];
+  if (unit.catalogue_id === "RETO-01") unit.duration_months = 36;
+}
+
+function fail(message: string): never { throw new Error(message); }
+function object(value: unknown, keys: string[], context: string): Record<string, unknown> {
+  if (!value || typeof value !== "object" || Array.isArray(value)) fail(`${context}: objeto requerido`);
+  const record = value as Record<string, unknown>;
+  if (Object.keys(record).length !== keys.length || keys.some((key) => !Object.hasOwn(record, key))) fail(`${context}: campos no admitidos o ausentes`);
+  return record;
+}
+function text(value: unknown, context: string, identifier = false): string {
+  if (typeof value !== "string" || !value.trim() || value.length > 150 || /[\u0000-\u001f\u007f]/u.test(value) || /^[-=+@]/u.test(value.trimStart())) fail(`${context}: texto inválido`);
+  if (identifier && !/^[A-Za-z0-9_-]{1,80}$/u.test(value)) fail(`${context}: identificador inválido`);
+  return value;
+}
+function validateUnit(value: unknown, enriched: boolean): Unit {
+  const keys = ["id", "functional_unit_id", "catalogue_id", "quantity", "municipalities"];
+  if (enriched) keys.push("cost_cop", "functional_unit", "eligibility");
+  const hasScope = !!value && typeof value === "object" && Object.hasOwn(value, "scope_hypothesis");
+  if (hasScope) keys.push("scope_hypothesis", "duration_months", "start_basis");
+  const hasPsaDuration = !!value && typeof value === "object" && !hasScope && (value as Record<string, unknown>).catalogue_id === "RETO-01" && Object.hasOwn(value, "duration_months");
+  if (hasPsaDuration) keys.push("duration_months");
+  const row = object(value, keys, "Unidad");
+  const id = text(row.id, "Unidad.id", true);
+  const catalogue_id = text(row.catalogue_id, "catalogue_id", true);
+  const entry = byId.get(catalogue_id);
+  if (!entry) fail(`Catálogo desconocido: ${catalogue_id}`);
+  const functional_unit_id = text(row.functional_unit_id, "functional_unit_id", true);
+  if (functional_unit_id !== `${catalogue_id}-UF-01`) fail("Identificador de unidad funcional no corresponde al catálogo");
+  if (row.quantity !== 1) fail("Cada fila exige una unidad indivisible completa; cantidad debe ser 1");
+  if (!Array.isArray(row.municipalities) || row.municipalities.some((m) => typeof m !== "string" || !MUNICIPALITIES.has(m)) || new Set(row.municipalities).size !== row.municipalities.length) fail("Municipios inválidos o repetidos");
+  const valid: Unit = { id, functional_unit_id, catalogue_id, quantity: 1, municipalities: [...row.municipalities] as string[] };
+  if (catalogue_id === "RETO-14") {
+    const hypothesis = hasScope ? row.scope_hypothesis
+      : row.eligibility === `${ELIGIBILITY}. ${RETO14_REGIONAL_CONDITION}` ? "regional_proposed" : "legacy_unspecified";
+    if (!["municipal_rionegro_proposed", "regional_proposed", "legacy_unspecified"].includes(hypothesis as string)) fail("Hipótesis RETO-14 desconocida");
+    valid.scope_hypothesis = hypothesis as Scope14;
+    valid.duration_months = hypothesis === "municipal_rionegro_proposed" ? 12 : null;
+    valid.start_basis = hypothesis === "municipal_rionegro_proposed" ? "acta_inicio" : null;
+    if (hasScope && (row.duration_months !== valid.duration_months || row.start_basis !== valid.start_basis)) fail("Plazo RETO-14 propuesto o base de inicio incompatibles");
+    if (hypothesis === "municipal_rionegro_proposed" && (valid.municipalities.length !== 1 || valid.municipalities[0] !== "05615")) fail("La propuesta municipal RETO-14 corresponde solo a Rionegro 05615");
+  } else if (hasScope) fail("La hipótesis de alcance RETO-14 no se aplica a otra medida");
+  if (hasPsaDuration) { if (row.duration_months !== 36) fail("PSA exige el programa completo de 36 meses"); valid.duration_months = 36; }
+  const legacyEligibility = !hasScope && (row.eligibility === ELIGIBILITY
+    || (catalogue_id === "RETO-14" && row.eligibility === `${ELIGIBILITY}. ${RETO14_REGIONAL_CONDITION}`));
+  if (enriched && (row.cost_cop !== entry.cost_cop || row.functional_unit !== entry.functional_unit
+    || (row.eligibility !== unitEligibility(valid) && !legacyEligibility))) fail("Costo, unidad funcional o condición territorial discrepan del catálogo");
+  return valid;
+}
+function validatePortfolio(value: unknown, enriched = false): Portfolio {
+  const row = object(value, ["id", "name", "units"], "Cartera");
+  const id = text(row.id, "Cartera.id", true);
+  const name = text(row.name, "Cartera.name");
+  if (!Array.isArray(row.units) || row.units.length < 1 || row.units.length > CATALOG.length) fail("La cartera exige entre 1 y 15 filas");
+  const units = row.units.map((unit) => validateUnit(unit, enriched));
+  if (new Set(units.map((unit) => unit.id)).size !== units.length || new Set(units.map((unit) => unit.catalogue_id)).size !== units.length) fail("Filas duplicadas en una cartera");
+  return { id, name, units };
+}
+function validatePair(values: unknown, enriched = false): Portfolio[] {
+  if (!Array.isArray(values) || ![2, 3].includes(values.length)) fail("Se requieren legado D6/N1 o tres casos M6-2/D6/N1");
+  const portfolios = values.map((value) => validatePortfolio(value, enriched));
+  const required = values.length === 3 ? ["M6-2", "D6", "N1"] : ["D6", "N1"];
+  if (new Set(portfolios.map(p => p.id)).size !== required.length || required.some(id => !portfolios.some(p => p.id === id))) fail("Identificadores de casos incompletos o repetidos");
+  return portfolios;
+}
+
+export function evaluatePortfolio(portfolio: Portfolio) {
+  const valid = validatePortfolio(portfolio);
+  const cost_cop = valid.units.reduce((sum, unit) => sum + byId.get(unit.catalogue_id)!.cost_cop, 0);
+  return { count: valid.units.length, cost_cop, balance_cop: BUDGET_COP - cost_cop, financially_feasible: cost_cop <= BUDGET_COP };
+}
+
+/** Enumeración financiera, sin coeficientes de beneficio ni validación ambiental. Incluye conjunto vacío. */
+export function compareCatalogue() {
+  let feasible_count = 0;
+  let max_count = 0;
+  let maximum_candidates: { ids: string[]; cost_cop: number; balance_cop: number }[] = [];
+  const subsets_examined = 2 ** CATALOG.length;
+  for (let mask = 0; mask < subsets_examined; mask++) {
+    const ids: string[] = [];
+    let cost_cop = 0;
+    for (let index = 0; index < CATALOG.length; index++) {
+      if ((mask & (1 << index)) !== 0) { ids.push(CATALOG[index].id); cost_cop += CATALOG[index].cost_cop; }
+    }
+    if (cost_cop > BUDGET_COP) continue;
+    feasible_count++;
+    if (ids.length > max_count) { max_count = ids.length; maximum_candidates = []; }
+    if (ids.length === max_count) maximum_candidates.push({ ids, cost_cop, balance_cop: BUDGET_COP - cost_cop });
+  }
+  return { subsets_examined, feasible_count, max_count, maximum_candidates };
+}
+
+export function exportPortfoliosJson(portfolios: Portfolio[]): string {
+  const valid = validatePair(portfolios);
+  return JSON.stringify({ format: valid.length === 3 ? "p2_motor_demo_v3" : FORMAT, ...(valid.length === 3 ? { case_snapshot: CASE_SNAPSHOT } : {}), source_sha256: SOURCE_SHA256, source_page: 5,
+    budget_cop: BUDGET_COP, counting_assumption: COUNTING_ASSUMPTION, eligibility: ELIGIBILITY,
+    portfolios: valid.map((p) => ({ ...p, units: p.units.map((u) => ({ ...u,
+      cost_cop: byId.get(u.catalogue_id)!.cost_cop,
+      functional_unit: byId.get(u.catalogue_id)!.functional_unit, eligibility: unitEligibility(u),
+    })) })),
+  }, null, 2);
+}
+
+function boundedInput(input: string): void {
+  if (typeof input !== "string" || input.length > 1_000_000) fail("Archivo inválido o demasiado grande");
+}
+/** JSON.parse conserva el último miembro repetido: rechazar esa ambigüedad del archivo. */
+function rejectDuplicateJsonKeys(input: string): void {
+  const stack: { object: boolean; expectingKey: boolean; keys: Set<string> }[] = [];
+  for (let i = 0; i < input.length; i++) {
+    const char = input[i];
+    if (char === '"') {
+      const start = i++;
+      while (i < input.length && input[i] !== '"') {
+        if (input[i] === "\\") i++;
+        i++;
+      }
+      const frame = stack.at(-1);
+      if (frame?.object && frame.expectingKey) {
+        const key = JSON.parse(input.slice(start, i + 1)) as string;
+        if (frame.keys.has(key)) fail("JSON ambiguo: clave repetida dentro de un objeto");
+        frame.keys.add(key);
+        frame.expectingKey = false;
+      }
+    } else if (char === "{" || char === "[") {
+      stack.push({ object: char === "{", expectingKey: char === "{", keys: new Set() });
+    } else if (char === "}" || char === "]") stack.pop();
+    else if (char === "," && stack.at(-1)?.object) stack.at(-1)!.expectingKey = true;
+  }
+}
+export function importPortfoliosJson(input: string): Portfolio[] {
+  boundedInput(input);
+  let parsed: unknown;
+  try { parsed = JSON.parse(input); } catch { return fail("JSON inválido"); }
+  rejectDuplicateJsonKeys(input);
+  const isCurrent = !!parsed && typeof parsed === "object" && (parsed as Record<string, unknown>).format === "p2_motor_demo_v3";
+  const doc = object(parsed, ["format", "source_sha256", "source_page", "budget_cop", "counting_assumption", "eligibility", "portfolios", ...(isCurrent ? ["case_snapshot"] : [])], "Documento");
+  if (isCurrent && JSON.stringify(doc.case_snapshot) !== JSON.stringify(CASE_SNAPSHOT)) fail("Snapshot de casos no corresponde a esta versión publicada");
+  if (![FORMAT, "p2_motor_demo_v1", "p2_motor_demo_v3"].includes(doc.format as string) || doc.source_sha256 !== SOURCE_SHA256 || doc.source_page !== 5 || doc.budget_cop !== BUDGET_COP || doc.counting_assumption !== COUNTING_ASSUMPTION || doc.eligibility !== ELIGIBILITY) fail("Formato, fuente, presupuesto o condiciones no corresponden a esta demo");
+  const cases = validatePair(doc.portfolios, true);
+  if ((cases.length === 3) !== isCurrent) fail("Versión no corresponde al conjunto de casos");
+  return cases;
+}
+
+const CSV_HEADER = ["cartera_id", "cartera_nombre", "id", "unidad_funcional_id", "catalogo_id", "cantidad", "municipios", "costo_cop", "unidad_funcional", "elegibilidad"];
+const CSV_HEADER_V2 = [...CSV_HEADER, "hipotesis_alcance", "duracion_meses", "inicio_base"];
+export function exportPortfoliosCsv(portfolios: Portfolio[]): string {
+  const rows = validatePair(portfolios).flatMap((p) => p.units.map((u) => [p.id, p.name, u.id, u.functional_unit_id,
+    u.catalogue_id, "1", u.municipalities.join("|"), String(byId.get(u.catalogue_id)!.cost_cop),
+    byId.get(u.catalogue_id)!.functional_unit, unitEligibility(u), u.scope_hypothesis ?? "", u.duration_months ?? "", u.start_basis ?? ""]));
+  return Papa.unparse([CSV_HEADER_V2, ...rows], { newline: "\r\n" });
+}
+export function importPortfoliosCsv(input: string): Portfolio[] {
+  boundedInput(input);
+  const parsed = Papa.parse<string[]>(input, { delimiter: ",", skipEmptyLines: "greedy" });
+  const v2 = JSON.stringify(parsed.data[0]) === JSON.stringify(CSV_HEADER_V2);
+  if (parsed.errors.length || parsed.data.length < 3 || (!v2 && JSON.stringify(parsed.data[0]) !== JSON.stringify(CSV_HEADER))) fail("CSV inválido o cabecera incorrecta");
+  const portfolios = new Map<string, { id: string; name: string; units: unknown[] }>();
+  for (const row of parsed.data.slice(1)) {
+    if (row.length !== (v2 ? CSV_HEADER_V2.length : CSV_HEADER.length)) fail("CSV: número de columnas incorrecto");
+    const [portfolioId, name, id, functionalId, catalogueId, quantity, municipalities, cost, functionalUnit, eligibility, scope, duration, start] = row;
+    if (quantity !== "1" || !/^[1-9][0-9]*$/u.test(cost)) fail("CSV: cantidad o costo entero inválido");
+    let portfolio = portfolios.get(portfolioId);
+    if (!portfolio) { portfolio = { id: portfolioId, name, units: [] }; portfolios.set(portfolioId, portfolio); }
+    if (portfolio.name !== name) fail("CSV: nombres inconsistentes para la misma cartera");
+    if (v2 && catalogueId === "RETO-01" && (scope !== "" || start !== "" || !["", "36"].includes(duration))) fail("CSV: PSA exige 36 meses completos sin inicio inventado");
+    if (v2 && !["RETO-14", "RETO-01"].includes(catalogueId) && (scope !== "" || duration !== "" || start !== "")) fail("CSV: alcance RETO-14 en otra medida");
+    if (v2 && catalogueId === "RETO-14" && (!scope || !["", "12"].includes(duration))) fail("CSV: alcance o plazo RETO-14 inválido");
+    portfolio.units.push({ id, functional_unit_id: functionalId, catalogue_id: catalogueId, quantity: 1,
+      municipalities: municipalities === "" ? [] : municipalities.split("|"), cost_cop: Number(cost),
+      functional_unit: functionalUnit, eligibility,
+      ...(v2 && catalogueId === "RETO-01" && duration === "36" ? { duration_months: 36 } : {}),
+      ...(v2 && catalogueId === "RETO-14" ? { scope_hypothesis: scope, duration_months: duration === "" ? null : Number(duration), start_basis: start === "" ? null : start } : {}),
+    });
+  }
+  return validatePair([...portfolios.values()], true);
+}

+import { publicResults } from '../../../../production/public-results';
+
+export const dynamic = 'force-static';
+export async function GET() {
+  return Response.json(publicResults, {
+    headers: { 'Cache-Control': 'public, max-age=300', 'X-Content-Type-Options': 'nosniff' },
+  });
+}
diff --git a/src/production/public-results.ts b/src/production/public-results.ts
new file mode 100644
--- /dev/null
+++ b/src/production/public-results.ts
@@ -0,0 +1,13 @@
+import snapshot from './public-results.json';
+
+/** Published municipal/portfolio aggregates only. No tenant or session dependency. */
+export type PublicResultRow = Record<string, string | null>;
+export const publicResults = snapshot;
+export type PublicResults = typeof publicResults;
+export const publicMunicipalities = [...new Set(snapshot.p1.map(row => row.municipio))].sort();
+export const publicPortfolios = [...new Set(snapshot.p3.map(row => row.cartera))].sort();
+export const primaryIndicators = snapshot.variables.filter(row => row.rol_seguimiento === 'BASE_PRIMARIA_INSTITUCIONAL_MEA_contexto');
+export const auxiliaryVariables = snapshot.variables.filter(row => row.rol_seguimiento === 'AUXILIAR_OPERATIVA_PROP_no_indicador_MEA');
+export function publicValue(value: string | null | undefined): string {
+  return value === null || value === undefined || value === '' || /^(null|nan|none)$/i.test(value) ? 'No informado' : value;
+}

@@ -0,0 +1,38 @@
+'use client';
+
+import { useState } from 'react';
+import Link from 'next/link';
+import { ArrowRight, BookOpen, CheckCircle2, Database, FileText, Leaf, LockKeyhole, MapPin, ShieldCheck, Sprout } from 'lucide-react';
+import { publicMunicipalities, publicPortfolios, publicResults, publicValue } from '../public-results';
+import '../public-results.css';
+
+const institutionalSources = [
+  ['Plan regional de adaptación · Valles de San Nicolás', 'https://observatorioambiental.cornare.gov.co/wp-content/uploads/2026/04/Copia-de-M-E-2852-Plan-Adaptacion-Regional-VSN-CORNARE-v2.pdf'],
+  ['Indicadores municipales ASCA', 'https://observatorioambiental.cornare.gov.co/wp-content/uploads/2026/04/Copia-de-M-E-2896-Anexo-1.-Indicadores-ASCA-Municipales.pdf'],
+  ['Fichas municipales de adaptación', 'https://observatorioambiental.cornare.gov.co/wp-content/uploads/2026/04/Copia-de-M-E-2897_Fichas_Adaptacion_Municipales1.xlsx'],
+  ['Manual del módulo MEA', 'https://observatorioambiental.cornare.gov.co/wp-content/uploads/2026/04/M-E-3269-Manual-de-Usuario-Modulo-MEA-1.pdf'],
+] as const;
+function Value({ value }: { value: string | null | undefined }) { return <span>{publicValue(value)}</span>; }
+function Category({ value }: { value: string | null }) { return <span className="pv-results-category">{publicValue(value)}</span>; }
+
+export function PublicResultsView() {
+  const [municipality, setMunicipality] = useState('Guarne');
+  const [portfolio, setPortfolio] = useState('D6');
+  const matches = (row: { municipio: string | null }) => municipality === 'Todos' || row.municipio === municipality;
+  const municipalRows = publicResults.p1.filter(matches);
+  const residualRows = publicResults.p3.filter(row => matches(row) && (portfolio === 'Todas' || row.cartera === portfolio));
+  return <div className="pv-doc-page pv-results">
+    <a className="pv-skip" href="#results-main">Ir a los resultados</a>
+    <header className="pv-doc-topbar"><Link className="pv-brand" href="/resultados"><Sprout size={29}/><span>Territorio Vivo<span className="pv-brand-dot">.</span></span></Link><nav aria-label="Navegación pública"><Link href="/documentacion"><BookOpen size={15}/>Documentación</Link><a href="https://hackathon-ambiental.stevenvallejo.com/metodologia">Metodología del reto</a><Link className="pv-button outline small" href="/login"><LockKeyhole size={14}/>Espacio de trabajo</Link></nav></header>
+    <div className="pv-doc-hero"><div><span className="pv-eyebrow"><i/>CONSULTA PÚBLICA · SIN INICIAR SESIÓN</span><h1>Decisiones con evidencia.<br/>Preguntas que siguen abiertas.</h1><p>Explora el diagnóstico municipal, el portafolio publicado y el seguimiento cualitativo del corredor Rionegro–Guarne–Marinilla.</p><div className="pv-doc-tags"><span><MapPin size={14}/>Tres municipios</span><span><Database size={14}/>Fuentes identificadas</span><span><ShieldCheck size={14}/>Límites explícitos</span></div><div className="pv-results-hero-links"><a className="pv-button primary" href="#diagnostico">Explorar resultados<ArrowRight size={16}/></a><a className="pv-button outline" href="#fuentes">Ver procedencia</a></div></div><aside><Leaf size={27}/><h2>Publicado, revisable.</h2><p>Esta consulta muestra una versión del proyecto. Las localizaciones y el seguimiento propuestos todavía requieren acuerdos y mediciones.</p><a href="#metodologia">Qué demuestra cada dato<ArrowRight size={14}/></a></aside></div>
+    <div className="pv-results-stats" aria-label="Contenido de la versión publicada"><article><strong>{publicResults.p1.length}</strong><span>Cruces municipales · P1</span></article><article><strong>{publicResults.p2.length}</strong><span>Medidas del portafolio D6 · P2</span></article><article><strong>{publicResults.p3.length}</strong><span>Residuales cualitativos · P3</span></article><article><strong>7</strong><span>Dimensiones de análisis</span></article></div>
+    <div className="pv-doc-layout"><aside className="pv-doc-index"><span className="pv-eyebrow">RESULTADOS ABIERTOS</span><nav aria-label="Índice de resultados">{[['diagnostico','Diagnóstico municipal'],['portafolio','Portafolio D6'],['seguimiento','Brechas y seguimiento'],['metodologia','Interpretación y límites'],['fuentes','Fuentes y versión']].map(([id, title], index) => <a href={`#${id}`} key={id}><span>{String(index + 1).padStart(2,'0')}</span>{title}</a>)}</nav></aside>
+    <main id="results-main"><div className="pv-doc-notice"><ShieldCheck size={20}/><p><strong>Evidencia documental y propuestas del equipo.</strong> Los datos institucionales y los productos publicados son reales; esta vista no usa fixtures sintéticos. El residual es cualitativo: no hay una reducción numérica de riesgo, eficacia de campo o atribución causal acreditada. La publicación no implica aval de CORNARE.</p></div>
+    <section id="diagnostico" className="pv-doc-section"><span className="pv-eyebrow">P1 · CONTEXTO INSTITUCIONAL</span><h2>Un diagnóstico por municipio y dimensión.</h2><p>Las categorías proceden del tablero publicado. A: amenaza; S: sensibilidad; CA: capacidad adaptativa; V: vulnerabilidad; R: riesgo. Los índices normalizados municipales que sustentan el tablero son contexto institucional; no son porcentajes físicos ni mediciones de un sitio intervenido.</p><div className="pv-results-filter"><label>Municipio<select aria-label="Municipio de consulta" value={municipality} onChange={event => setMunicipality(event.target.value)}><option>Todos</option>{publicMunicipalities.map(name => <option key={name ?? ''}>{name}</option>)}</select></label><span aria-live="polite">{municipalRows.length} de {publicResults.p1.length} cruces municipales</span></div><div className="pv-table-wrap"><table className="pv-table"><caption>Categorías institucionales publicadas · referencia y proyección SSP3-7.0</caption><thead><tr><th>Municipio / dimensión</th><th>A ref.</th><th>S ref.</th><th>CA ref.</th><th>V ref.</th><th>R ref.</th><th>R SSP3 · 2060</th></tr></thead><tbody>{municipalRows.map(row => <tr key={`${row.municipio}-${row.dimension}`}><th scope="row"><strong>{row.dimension}</strong><small className="pv-results-cell-note">{row.municipio}</small></th><td><Category value={row.categoria_A_ref}/></td><td><Category value={row.categoria_S_ref}/></td><td><Category value={row.categoria_CA_ref}/></td><td><Category value={row.categoria_V_ref}/></td><td><Category value={row.categoria_R_ref}/></td><td><Category value={row.categoria_R_SSP3_2060}/></td></tr>)}</tbody></table></div><p className="pv-results-small">Contraste principal solicitado: referencia → SSP3-7.0 / 2041–2060. Intermedio y estrés coinciden en este contraste y no constituyen dos pruebas independientes. SSP2-4.5 / 2021–2040 es una comparación exploratoria.</p><details className="pv-disclosure"><summary>Localizadores del tablero y comparación exploratoria</summary>{municipalRows.map(row => <div className="pv-results-provenance" key={`${row.municipio}-${row.dimension}`}><strong>{row.municipio} · {row.dimension}</strong><p>R SSP2-4.5 exploratorio: <Value value={row.categoria_R_SSP2_2040}/>. Año de referencia declarado: <Value value={row.baseline_year}/>; no equivale a una basal física de intervención.</p><p>Fuente: <Value value={row.fuente}/> · Hoja: <Value value={row.hoja}/> · Celdas: <Value value={row.celdas}/></p></div>)}</details></section>
+    <section id="portafolio" className="pv-doc-section"><span className="pv-eyebrow">P2 · UNIDADES COMPLETAS</span><h2>Las seis medidas publicadas de D6.</h2><p>Precios en millones de COP según el catálogo del reto. La localización es propuesta y no acredita sitios habilitados, permisos, acuerdos ni efectos medidos. Los códigos RETO son identificadores locales, distintos de códigos oficiales de indicadores MEA.</p><div className="pv-results-portfolio">{publicResults.p2.map(row => <article key={row.id_local_no_codigo_mea ?? ''}><div className="pv-results-card-top"><span className="pv-results-category">{row.id_local_no_codigo_mea}</span><strong>{row.costo_millones_cop} M COP</strong></div><h3>{row.medida}</h3><p><MapPin size={14}/><Value value={row.municipio_localizacion_propuesta}/></p><p><strong>Unidad propuesta:</strong> <Value value={row.unidad_funcional_propuesta}/></p><p><strong>Beneficio esperado:</strong> <Value value={row.beneficio_esperado_cualitativo}/></p><details><summary>Condiciones y pendientes</summary><p><strong>Estado:</strong> <Value value={row.estado}/></p><p><strong>Elegibilidad:</strong> <Value value={row.condiciones_de_elegibilidad}/></p><p><strong>Dato decisivo faltante:</strong> <Value value={row.faltante_operativo_decisivo}/></p><p><strong>Eficacia cuantificada:</strong> <Value value={row.eficacia_cuantificada}/></p><p><strong>Duración operativa propuesta:</strong> <Value value={row.duracion_operativa_propuesta_meses}/> meses. La fecha efectiva de inicio no está acreditada aquí.</p></details></article>)}</div></section>
+    <section id="seguimiento" className="pv-doc-section"><span className="pv-eyebrow">P3 · RESIDUAL CUALITATIVO</span><h2>Lo que una cartera todavía deja abierto.</h2><p>Los 42 cruces describen dos carteras, tres municipios y siete dimensiones. Una medida nombrada como contexto de cartera no demuestra cobertura local. La descripción del residual no es un nuevo índice V/R ni una estimación de efecto posterior.</p><div className="pv-results-filter"><label>Cartera<select aria-label="Cartera de seguimiento" value={portfolio} onChange={event => setPortfolio(event.target.value)}><option value="Todas">Todas</option>{publicPortfolios.map(name => <option key={name ?? ''}>{name}</option>)}</select></label><span aria-live="polite">{residualRows.length} de {publicResults.p3.length} cruces · {municipality}</span></div><div className="pv-results-residuals">{residualRows.map(row => <article key={`${row.cartera}-${row.municipio}-${row.dimension}`}><div className="pv-results-card-top"><span className="pv-results-category">{row.cartera} · {row.municipio}</span><span className="pv-results-small">{publicValue(row.cobertura_local_estado)}</span></div><h3>{row.dimension}</h3><p><strong>Residual no estimado:</strong> <Value value={row.residual_no_estimado}/></p><p><strong>Qué cambia la decisión:</strong> <Value value={row.condicion_que_cambia_decision}/></p><details><summary>Evidencia, propuesta y condición de cierre</summary><p><strong>Mecanismo esperado:</strong> <Value value={row.mecanismo_esperado}/></p><p><strong>Medidas referidas:</strong> <Value value={row.medidas_catalogo}/></p><p><strong>Estado de evidencia:</strong> <Value value={row.estado_evidencia_actual}/></p><p><strong>Localización:</strong> <Value value={row.localizacion_estado}/></p><p><strong>Evidencia de cierre PROP:</strong> <Value value={row.evidencia_cierre_PROP}/></p><p><strong>Variables propuestas existentes:</strong> <Value value={row.ids_variables_operativas}/></p><p><strong>Contraste:</strong> <Value value={row.contraste_futuro}/></p><p><strong>Procedencia:</strong> <Value value={row.fuente_contexto}/> · <Value value={row.localizadores_contexto}/></p></details></article>)}</div></section>
+    <section id="metodologia" className="pv-doc-section"><span className="pv-eyebrow">CUATRO NIVELES DE EVIDENCIA</span><h2>Medir, interpretar y mantener los límites.</h2><div className="pv-doc-cards two"><article><Database size={21}/><h3>Proyección institucional</h3><p>Contexto municipal publicado con fuente y localizador. Un índice de 0–1 no se convierte en hectáreas, COP o eficacia de una medida.</p></article><article><FileText size={21}/><h3>Residual cualitativo</h3><p>Brechas, cobertura propuesta y condiciones para revisar una cartera. No expresa un riesgo numérico posterior a la intervención.</p></article><article><CheckCircle2 size={21}/><h3>Medición posterior PROP</h3><p>Requiere basal física previa, mismo sitio o sistema, unidad, denominador y método comparables. Basales físicas, sitios y custodios aceptados siguen pendientes donde no están acreditados.</p></article><article><ShieldCheck size={21}/><h3>Atribución causal</h3><p>Un antes–después no separa por sí solo clima, mantenimiento o programas concurrentes. Una contribución plausible exige contexto; la causalidad no está acreditada.</p></article></div><div className="pv-doc-human"><ShieldCheck size={21}/><div><strong>Los proxies tienen un alcance limitado.</strong><p>Supervivencia vegetal no demuestra función climática; kg/ha no prueba resiliencia; recepción de información sin uso no acredita capacidad GRD. Recepción y uso documentados son un resultado operativo limitado, distinto de un SAT completo.</p></div></div><p>El Manual MEA documenta campos y reportes, no acredita captura, login o persistencia operativa realizados por este proyecto. Se aprovechan las fuentes y funciones existentes; las propuestas no se homologan automáticamente como indicadores oficiales.</p><a className="pv-text-link" href="https://hackathon-ambiental.stevenvallejo.com/metodologia">Leer la metodología del proyecto<ArrowRight size={14}/></a></section>
